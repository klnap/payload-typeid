{
  "name": "@klnap/payload-typeid",
  "version": "0.1.0",
  "description": "Type-prefixed UUIDv7 primary keys for Payload CMS.",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klnap/payload-typeid.git"
  },
  "homepage": "https://github.com/klnap/payload-typeid#readme",
  "bugs": {
    "url": "https://github.com/klnap/payload-typeid/issues"
  },
  "keywords": [
    "typescript",
    "payload",
    "typeid",
    "uuidv7"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:postgres": "PAYLOAD_DB_PUSH=true PAYLOAD_FORCE_DRIZZLE_PUSH=true bun test --timeout 30000 ./tests/postgres.integration.ts",
    "verify:package": "publint --strict && attw --profile esm-only --pack .",
    "check": "bun run format && bun run lint && bun run typecheck && bun run build && bun test && bun run verify:package",
    "prepublishOnly": "node -e \"if (require('./package.json').private) throw new Error('This package is private and cannot be published')\"",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:version-check": "bun run changeset:version && bun run check"
  },
  "peerDependencies": {
    "payload": "^3.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@payloadcms/db-postgres": "3.94.2",
    "@types/bun": "1.4.5",
    "npm": "12.2.3",
    "payload": "3.94.2",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  }
}
